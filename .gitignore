# ==========================================================
# 超市管理系统 (SupermarketManage) 根目录 .gitignore
# ==========================================================

# ---------------- 操作系统 / 编辑器 ----------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# JetBrains (IDEA) —— 本地配置，不共享
.idea/
*.iml
*.ipr
*.iws
out/

# VS Code —— 只保留推荐的扩展列表
.vscode/*
!.vscode/extensions.json

# ---------------- 通用 ----------------
*.log
logs/
*.tmp
*.bak
*.swp
*~
.env
.env.local
.env.*.local

# ==========================================================
# 后端 smanage_backend (Spring Boot / Maven)
# ==========================================================

# Maven 构建产物
smanage_backend/target/
target/

# 编译输出
*.class

# 崩溃日志
hs_err_pid*
replay_pid*

# Spring Boot 本地覆盖配置（数据库密码等放这里，不要提交）
application-local.yml
application-local.properties

# Maven 命令行 -Dmaven.test.skip 等生成的标记
.mvn/timing.properties

# ==========================================================
# 前端 smanage_frontend (Vue 3 + Vite)
# ==========================================================

# 依赖目录 —— 体积巨大，由 npm install 生成
node_modules/
**/node_modules/

# 构建产物
dist/
dist-ssr/
build/
.vite/

# 包管理器日志与缓存
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.eslintcache

# 注意：package-lock.json 一定要提交，不要忽略它

# ==========================================================
# 运行时产生的文件
# ==========================================================

# 后台上传的商品图片（运行时生成，不入库）
picture/*
!picture/.gitkeep
